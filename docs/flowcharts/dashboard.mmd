---
title: Dashboard Service Flow
---
flowchart TD
  U([User]) -->|"user action"| P["pages/Index.tsx (Dashboard)"]
  P <-->|"request / rendered data"| H["useDashboard (stats, recent requests, quotas)"]
  H <-->|"query request / cached response"| Q["React Query cache<br/>(keys, refetch, invalidate)"]
  Q <-->|"fetch request / parsed response"| A["dashboardApi"]
  A <-->|"HTTP request / HTTP response"| C["apiClient (Axios)<br/>token injection - 401 refresh - 403 role refresh"]
  C <-->|"REST request / JSON response"| S[("VM Request Service + User Management Service")]
  P -->|"renders"| UI
  subgraph UI[Page interactions]
    direction LR
    S0["Stat cards (requests, VMs, users)"]
    S1["Recent requests table with 15s refetch"]
    S2["Service quota cards with per-service request quota increase button"]
    S3["Navigate to feature pages"]
    S0 ~~~ S1 ~~~ S2 ~~~ S3
  end
  C -. "error response" .-> E["ApiErrorBoundary + toast"]
  E ~~~ UI

  %% ---- Key decisions ----
  P -->|"evaluate"| X0
  X0{"Quota usage near limit?"} -->|"yes"| X1["Highlight card + show request quota increase"]
  X0 -->|"no"| X2["Show normal usage"]
  X3{"Recent requests found?"} -->|"yes"| X4["Render table (15s refetch)"]
  X3 -->|"no"| X5["Show empty state"]

