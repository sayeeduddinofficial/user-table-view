---
title: Route 53 Service Flow
---
flowchart TD
  U([User]) -->|"user action"| P["pages/Route53.tsx + HostedZoneDetails / CreateRecord"]
  P <-->|"request / rendered data"| H["useRoute53"]
  H <-->|"query request / cached response"| Q["React Query cache<br/>(keys, refetch, invalidate)"]
  Q <-->|"fetch request / parsed response"| A["route53Api"]
  A <-->|"HTTP request / HTTP response"| C["apiClient (Axios)<br/>token injection - 401 refresh - 403 role refresh"]
  C <-->|"REST request / JSON response"| S[("Route 53 Service")]
  P -->|"renders"| UI
  subgraph UI[Page interactions]
    direction LR
    S0["List hosted zones"]
    S1["View zone details and record sets"]
    S2["Create record (A, CNAME, TXT ...)"]
    S3["Delete record"]
    S4["Request quota increase"]
    S0 ~~~ S1 ~~~ S2 ~~~ S3 ~~~ S4
  end
  C -. "error response" .-> E["ApiErrorBoundary + toast"]

  %% ---- Condition-based paths ----
  Q -->|"cache lookup"| D1{"Cached data<br/>still fresh?"}
  D1 -->|"yes"| P
  D1 -->|"no"| A
  C -->|"before send"| D2{"Access token<br/>valid?"}
  D2 -->|"yes"| S
  D2 -->|"no"| RT["Refresh token"]
  RT -->|"retry request"| S
  RT -. "refresh failed" .-> LO["Sign out - redirect /login"]
  S -->|"response"| D3{"HTTP 2xx?"}
  D3 -->|"yes"| Q
  D3 -->|"no"| D4{"403 role change?"}
  D4 -->|"yes"| RR["Refresh role and retry"]
  D4 -->|"no"| E
  %% ---- Service specific decisions ----
  X0{"Record already exists?"} -->|"yes"| X1["Block create - show conflict"]
  X0 -->|"no"| X2{"Record type valid for value?"}
  X2 -->|"yes"| X3["Create record set"]
  X2 -->|"no"| X4["Show validation error"]
