---
title: Load Balancer Service Flow
---
flowchart TD
  U([User]) -->|"user action"| P["pages/AwsLoadBalancers.tsx + LoadBalancerDetails / CreateLoadBalancer"]
  P <-->|"request / rendered data"| H["useLoadBalancers"]
  H <-->|"query request / cached response"| Q["React Query cache<br/>(keys, refetch, invalidate)"]
  Q <-->|"fetch request / parsed response"| A["loadBalancerApi"]
  A <-->|"HTTP request / HTTP response"| C["apiClient (Axios)<br/>token injection - 401 refresh - 403 role refresh"]
  C <-->|"REST request / JSON response"| S[("Load Balancer Service")]
  P -->|"renders"| UI
  subgraph UI[Page interactions]
    direction LR
    S0["List ALB / NLB"]
    S1["Create load balancer by type (ALB or NLB)"]
    S2["Listeners, target groups and health checks"]
    S3["Create security group"]
    S4["Request quota increase"]
    S0 ~~~ S1 ~~~ S2 ~~~ S3 ~~~ S4
  end
  C -. "error response" .-> E["ApiErrorBoundary + toast"]
  E ~~~ UI

  %% ---- Key decisions ----
  P -->|"evaluate"| X0
  X0{"LB type?"} -->|"ALB"| X1["HTTP/HTTPS listeners + target groups"]
  X0 -->|"NLB"| X2["TCP/TLS listeners + target groups"]
  X1 --> X3{"Security group selected?"}
  X2 --> X3
  X3 -->|"yes"| X4["Create load balancer"]
  X3 -->|"no"| X5["Create security group first"]

