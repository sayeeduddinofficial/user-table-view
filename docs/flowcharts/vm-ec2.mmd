---
title: VM / EC2 Service Flow
---
flowchart TD
  U([User]) -->|"user action"| P["pages/MyVMs.tsx + NewRequest.tsx (create VM)"]
  P <-->|"request / rendered data"| H["useMyVMs / useVMRequestForm"]
  H <-->|"query request / cached response"| Q["React Query cache<br/>(keys, refetch, invalidate)"]
  Q <-->|"fetch request / parsed response"| A["myVMsApi / vmRequestsApi"]
  Q <-->|"fetch request / parsed response"| A["myVMsApi / vmRequestsApi"]
  A <-->|"HTTP request / HTTP response"| C["apiClient (Axios)<br/>token injection - 401 refresh - 403 role refresh"]
  C <-->|"REST request / JSON response"| S[("VM Request Service")]
  P -->|"renders"| UI
  subgraph UI[Page interactions]
    direction LR
    S0["List VMs with filters and search"]
    S1["Create VM page (VMRequestForm)<br/>category, roles, schedule, justification"]
    S2["Start / Stop / Reboot / Terminate"]
    S3["View instance details and tags"]
    S4["Open web console / SSH key download"]
    S5["Request quota increase"]
    S0 ~~~ S1 ~~~ S2 ~~~ S3 ~~~ S4 ~~~ S5
  end
  C -. "error response" .-> E["ApiErrorBoundary + toast"]
  E ~~~ UI

  %% ---- Key decisions ----
  P -->|"evaluate"| X0
  X0{"Category 1 selected?"} -->|"yes"| X1{"Provision mode?"}
  X0 -->|"no"| X2["Category specific infra sections"]
  X1 -->|"Splunk deployment"| X3["roles[] payload"]
  X1 -->|"General purpose"| X4["vmGroups[] payload (max 10)"]
  X3 --> X5{"Form valid<br/>(AMI, names unique)?"}
  X4 --> X5
  X2 --> X5
  X5 -->|"yes"| X6["Confirm dialog -> submit request"]
  X5 -->|"no"| X7["Show validation errors"]

