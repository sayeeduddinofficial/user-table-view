---
title: Request Management Service Flow
---
flowchart TD
  U([User]) -->|"user action"| P["pages/Requests.tsx + NewRequest.tsx"]
  P <-->|"request / rendered data"| H["useRequestsList / useVMRequestForm"]
  H <-->|"query request / cached response"| Q["React Query cache<br/>(keys, refetch, invalidate)"]
  Q <-->|"fetch request / parsed response"| A["vmRequestsApi"]
  A <-->|"HTTP request / HTTP response"| C["apiClient (Axios)<br/>token injection - 401 refresh - 403 role refresh"]
  C <-->|"REST request / JSON response"| S[("VM Request Service")]
  P -->|"renders"| UI
  subgraph UI[Page interactions]
    direction TB
    S0["Create new resource request (ChooseServices dialog)"]
    S1["Track request status timeline"]
    S2["Approve / reject (approver role)"]
    S3["Filter by status, service and date"]
    S0 ~~~ S1 ~~~ S2 ~~~ S3
  end
  C -. "error response" .-> E["ApiErrorBoundary + toast"]

  %% ---- Key decisions ----
  P -->|"evaluate"| X0
  X0{"Approver role?"} -->|"yes"| X1{"Approve or reject?"}
  X0 -->|"no"| X2["Read-only status view"]
  X1 -->|"approve"| X3["Provision resources"]
  X1 -->|"reject"| X4["Notify requester"]
  X5{"Delete in flight?"} -->|"yes"| X6["Disable delete icon - Terminating..."]
  X5 -->|"no"| X7["Allow delete"]
