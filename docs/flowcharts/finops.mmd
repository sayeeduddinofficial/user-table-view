---
title: FinOps / Leadership Billing Flow
---
flowchart TD
  U([User]) -->|"user action"| P["pages/LeadershipBilling.tsx (FinOpsRoute)"]
  P <-->|"request / rendered data"| H["useKPIData / useLeadership"]
  H <-->|"query request / cached response"| Q["React Query cache<br/>(keys, refetch, invalidate)"]
  Q <-->|"fetch request / parsed response"| A["billingApi"]
  A <-->|"HTTP request / HTTP response"| C["apiClient (Axios)<br/>token injection - 401 refresh - 403 role refresh"]
  C <-->|"REST request / JSON response"| S[("AWS Config Service")]
  P -->|"renders"| UI
  subgraph UI[Page interactions]
    direction LR
    S0["Cost KPIs and trend charts"]
    S1["KPI detail dialog drill-down"]
    S2["Breakdown by service and account"]
    S3["Export report"]
    S0 ~~~ S1 ~~~ S2 ~~~ S3
  end
  C -. "error response" .-> E["ApiErrorBoundary + toast"]

  %% ---- Condition-based paths ----
  Q -->|"cache lookup"| D1{"Cached data<br/>still fresh?"}
  D1 -->|"yes"| P
  D1 -->|"no"| A
  C -->|"before send"| D2{"Access token<br/>valid?"}
  D2 -->|"yes"| S
  D2 -->|"no"| RT["Refresh token"]
  RT -->|"retry request"| S
  RT -. "refresh failed" .-> LO["Sign out - redirect /login"]
  S -->|"response"| D3{"HTTP 2xx?"}
  D3 -->|"yes"| Q
  D3 -->|"no"| D4{"403 role change?"}
  D4 -->|"yes"| RR["Refresh role and retry"]
  D4 -->|"no"| E
  %% ---- Service specific decisions ----
  X0{"FinOps or leadership role?"} -->|"yes"| X1["Load cost KPIs"]
  X0 -->|"no"| X2["Access denied"]
  X1 --> X3{"KPI card clicked?"}
  X3 -->|"yes"| X4["Open drill-down dialog"]
  X3 -->|"no"| X5["Show summary charts"]
