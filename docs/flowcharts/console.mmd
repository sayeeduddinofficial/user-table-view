title: Console (Live Logs) Flow
---
flowchart TD
  U([User]) -->|"user action"| P["pages/Console.tsx"]
  P <-->|"request / rendered data"| H["useLiveConsole / socket client"]
  H <-->|"query request / cached response"| Q["React Query cache<br/>(keys, refetch, invalidate)"]
  Q <-->|"fetch request / parsed response"| A["liveConsoleApi"]
  A <-->|"HTTP request / HTTP response"| C["apiClient (Axios)<br/>token injection - 401 refresh - 403 role refresh"]
  C <-->|"REST request / JSON response"| S[("Notification Socket Service")]
  P -->|"renders"| UI
  subgraph UI[Page interactions]
    direction TB
    S0["Open socket connection with auth token"]
    S1["Subscribe to resource log stream"]
    S2["Live append and autoscroll"]
    S3["Disconnect on unmount"]
    S0 ~~~ S1 ~~~ S2 ~~~ S3
  end
  C -. "error response" .-> E["ApiErrorBoundary + toast"]

  %% ---- Key decisions ----
  P -->|"evaluate"| X0
  X0{"Socket connected?"} -->|"yes"| X1["Stream and append logs"]
  X0 -->|"no"| X2{"Retry attempts left?"}
  X2 -->|"yes"| X3["Reconnect with auth token"]
  X2 -->|"no"| X4["Show connection error"]
  X1 --> X5{"Autoscroll enabled?"}
  X5 -->|"yes"| X6["Scroll to latest"]
  X5 -->|"no"| X7["Keep scroll position"]
