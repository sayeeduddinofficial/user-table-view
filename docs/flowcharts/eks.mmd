---
title: EKS Service Flow
---
flowchart TD
  U([User]) -->|"user action"| P["pages/Eks.tsx + EksDetails / CreateEks"]
  P <-->|"request / rendered data"| H["useEks"]
  H <-->|"query request / cached response"| Q["React Query cache<br/>(keys, refetch, invalidate)"]
  Q <-->|"fetch request / parsed response"| A["eksApi"]
  A <-->|"HTTP request / HTTP response"| C["apiClient (Axios)<br/>token injection - 401 refresh - 403 role refresh"]
  C <-->|"REST request / JSON response"| S[("EKS Cluster Service")]
  P -->|"renders"| UI
  subgraph UI[Page interactions]
    direction LR
    S0["List clusters and status"]
    S1["Create cluster (version, node groups)"]
    S2["View nodegroups, addons and workloads"]
    S3["Delete / scale cluster"]
    S4["Request quota increase"]
    S0 ~~~ S1 ~~~ S2 ~~~ S3 ~~~ S4
  end
  C -. "error response" .-> E["ApiErrorBoundary + toast"]
  E ~~~ UI

  %% ---- Key decisions ----
  P -->|"evaluate"| X0
  X0{"Cluster quota available?"} -->|"yes"| X1["Create cluster"]
  X0 -->|"no"| X2["Request quota increase"]
  X1 --> X3{"Cluster ACTIVE?"}
  X3 -->|"yes"| X4["Show nodes, node pools, node groups"]
  X3 -->|"no"| X5["Show provisioning state - poll"]

