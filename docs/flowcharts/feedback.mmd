---
title: Feedback Service Flow
---
flowchart TD
  U([User]) -->|"user action"| P["pages/feedback.tsx + AdminFeedback.tsx"]
  P <-->|"request / rendered data"| H["useFeedback"]
  H <-->|"query request / cached response"| Q["React Query cache<br/>(keys, refetch, invalidate)"]
  Q <-->|"fetch request / parsed response"| A["feedbackApi"]
  A <-->|"HTTP request / HTTP response"| C["apiClient (Axios)<br/>token injection - 401 refresh - 403 role refresh"]
  C <-->|"REST request / JSON response"| S[("Feedback Service")]
  P -->|"renders"| UI
  subgraph UI[Page interactions]
    direction LR
    S0["Submit feedback with attachments (FormData)"]
    S1["Admin list and triage"]
    S2["Update status and respond"]
    S3["Filter by category and severity"]
    S0 ~~~ S1 ~~~ S2 ~~~ S3
  end
  C -. "error response" .-> E["ApiErrorBoundary + toast"]

  %% ---- Condition-based paths ----
  Q -->|"cache lookup"| D1{"Cached data<br/>still fresh?"}
  D1 -->|"yes"| P
  D1 -->|"no"| A
  C -->|"before send"| D2{"Access token<br/>valid?"}
  D2 -->|"yes"| S
  D2 -->|"no"| RT["Refresh token"]
  RT -->|"retry request"| S
  RT -. "refresh failed" .-> LO["Sign out - redirect /login"]
  S -->|"response"| D3{"HTTP 2xx?"}
  D3 -->|"yes"| Q
  D3 -->|"no"| D4{"403 role change?"}
  D4 -->|"yes"| RR["Refresh role and retry"]
  D4 -->|"no"| E
  %% ---- Service specific decisions ----
  X0{"Attachment added?"} -->|"yes"| X1["Submit as FormData"]
  X0 -->|"no"| X2["Submit as JSON"]
  X3{"Admin role?"} -->|"yes"| X4["Triage - update status and respond"]
  X3 -->|"no"| X5["View own submissions only"]
