flowchart TD
  U([User]) -->|"user action"| P["pages/Settings.tsx + Profile.tsx"]
  P <-->|"request / rendered data"| H["useSystemSettings / useProfile"]
  H <-->|"query request / cached response"| Q["React Query cache<br/>(keys, refetch, invalidate)"]
  Q <-->|"fetch request / parsed response"| A["settingsApi / profileApi"]
  A <-->|"HTTP request / HTTP response"| C["apiClient (Axios)<br/>token injection - 401 refresh - 403 role refresh"]
  C <-->|"REST request / JSON response"| S[("AWS Config Service + User Management Service")]
  P -->|"renders"| UI
  subgraph UI[Page interactions]
    direction LR
    S0["Theme and preferences"]
    S1["AWS account/config settings (admin)"]
    S2["Profile details and SSH keys"]
    S3["Save and invalidate caches"]
    S0 ~~~ S1 ~~~ S2 ~~~ S3
  end
  C -. "error response" .-> E["ApiErrorBoundary + toast"]

  %% ---- Key decisions ----
  P -->|"evaluate"| X0
  X0{"Admin role?"} -->|"yes"| X1["Show AWS config / terraform backend sections"]
  X0 -->|"no"| X2["Show profile and preferences only"]
  X3{"Save valid?"} -->|"yes"| X4["Persist and invalidate caches"]
  X3 -->|"no"| X5["Show field errors"]
