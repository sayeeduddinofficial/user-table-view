---
title: VPC Service Flow
---
flowchart TD
  U([User]) -->|"user action"| P["pages/Vpcs.tsx + VpcDetails / CreateVpc"]
  P <-->|"request / rendered data"| H["useVpcList"]
  H <-->|"query request / cached response"| Q["React Query cache<br/>(keys, refetch, invalidate)"]
  Q <-->|"fetch request / parsed response"| A["vpcApi / vpcService"]
  A <-->|"HTTP request / HTTP response"| C["apiClient (Axios)<br/>token injection - 401 refresh - 403 role refresh"]
  C <-->|"REST request / JSON response"| S[("VPC Service")]
  P -->|"renders"| UI
  subgraph UI[Page interactions]
    direction TB
    S0["List VPCs with stat cards and row selection"]
    S1["VPC details screen<br/>(resource map, CIDRs, tags)"]
    S2["Create VPC - 'VPC only' option"]
    S3["Create VPC - 'VPC and more' option<br/>(subnets, NAT gateways, endpoints)"]
    S4["Live preview panel with connector lines<br/>('VPC and more' only)"]
    S5["Name tag auto-generation for<br/>subnets, route tables and NAT gateways"]
    S6["Delete VPC"]
    S7["Request quota increase"]
    S0 ~~~ S1 ~~~ S2 ~~~ S3 ~~~ S4 ~~~ S5 ~~~ S6 ~~~ S7
  end
  C -. "error response" .-> E["ApiErrorBoundary + toast"]

  %% ---- Key decisions ----
  P -->|"evaluate"| X0
  X0{"User already has a VPC<br/>or one provisioning?"} -->|"yes"| X1["Disable Create VPC"]
  X0 -->|"no"| X2{"Create mode?"}
  X2 -->|"VPC only"| X3["Create VPC only"]
  X2 -->|"VPC and more"| X4["Show live preview + auto name tags"]
  X3 --> X5{"Name unique in region?"}
  X4 --> X5
  X5 -->|"yes"| X6["POST create - track requestId as provisioning"]
  X5 -->|"no"| X7["Show duplicate name error"]
