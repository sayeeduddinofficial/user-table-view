---
title: S3 Bucket Service Flow
---
flowchart TD
  U([User]) -->|"user action"| P["pages/S3.tsx"]
  P <-->|"request / rendered data"| H["useS3Buckets / useS3Quota"]
  H <-->|"query request / cached response"| Q["React Query cache<br/>(keys, refetch, invalidate)"]
  Q <-->|"fetch request / parsed response"| A["bucketService / objectService"]
  A <-->|"HTTP request / HTTP response"| C["apiClient (Axios)<br/>token injection - 401 refresh - 403 role refresh"]
  C <-->|"REST request / JSON response"| S[("S3 Bucket Service")]
  P -->|"renders"| UI
  subgraph UI[Page interactions]
    direction LR
    S0["List buckets"]
    S1["Create bucket (region, versioning, encryption)"]
    S2["Browse objects, upload and delete"]
    S3["Manage bucket policy and lifecycle"]
    S4["Request quota increase"]
    S0 ~~~ S1 ~~~ S2 ~~~ S3 ~~~ S4
  end
  C -. "error response" .-> E["ApiErrorBoundary + toast"]

  %% ---- Condition-based paths ----
  Q -->|"cache lookup"| D1{"Cached data<br/>still fresh?"}
  D1 -->|"yes"| P
  D1 -->|"no"| A
  C -->|"before send"| D2{"Access token<br/>valid?"}
  D2 -->|"yes"| S
  D2 -->|"no"| RT["Refresh token"]
  RT -->|"retry request"| S
  RT -. "refresh failed" .-> LO["Sign out - redirect /login"]
  S -->|"response"| D3{"HTTP 2xx?"}
  D3 -->|"yes"| Q
  D3 -->|"no"| D4{"403 role change?"}
  D4 -->|"yes"| RR["Refresh role and retry"]
  D4 -->|"no"| E
  %% ---- Service specific decisions ----
  X0{"Bucket name available<br/>and quota left?"} -->|"yes"| X1["Create bucket"]
  X0 -->|"no"| X2["Show error / quota request"]
  X3{"Bucket empty?"} -->|"yes"| X4["Delete bucket"]
  X3 -->|"no"| X5["Block delete - remove objects first"]
