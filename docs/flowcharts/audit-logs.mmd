---
title: Audit Logs Service Flow
---
flowchart TD
  U([User]) -->|"user action"| P["pages/AuditLogs.tsx"]
  P <-->|"request / rendered data"| H["useAuditLogsPage"]
  H <-->|"query request / cached response"| Q["React Query cache<br/>(keys, refetch, invalidate)"]
  Q <-->|"fetch request / parsed response"| A["auditApi"]
  A <-->|"HTTP request / HTTP response"| C["apiClient (Axios)<br/>token injection - 401 refresh - 403 role refresh"]
  C <-->|"REST request / JSON response"| S[("User Management Service")]
  P -->|"renders"| UI
  subgraph UI[Page interactions]
    direction LR
    S0["Filter by service, user, action and date range"]
    S1["Stat cards and analytics charts"]
    S2["Paginated log table"]
    S3["Export CSV / PNG / PDF"]
    S0 ~~~ S1 ~~~ S2 ~~~ S3
  end
  C -. "error response" .-> E["ApiErrorBoundary + toast"]

  %% ---- Condition-based paths ----
  Q -->|"cache lookup"| D1{"Cached data<br/>still fresh?"}
  D1 -->|"yes"| P
  D1 -->|"no"| A
  C -->|"before send"| D2{"Access token<br/>valid?"}
  D2 -->|"yes"| S
  D2 -->|"no"| RT["Refresh token"]
  RT -->|"retry request"| S
  RT -. "refresh failed" .-> LO["Sign out - redirect /login"]
  S -->|"response"| D3{"HTTP 2xx?"}
  D3 -->|"yes"| Q
  D3 -->|"no"| D4{"403 role change?"}
  D4 -->|"yes"| RR["Refresh role and retry"]
  D4 -->|"no"| E
  %% ---- Service specific decisions ----
  X0{"Audit role?"} -->|"yes"| X1["Load logs with filters"]
  X0 -->|"no"| X2["Access denied"]
  X1 --> X3{"Results found?"}
  X3 -->|"yes"| X4["Render charts and paginated table"]
  X3 -->|"no"| X5["Show empty state"]
  X4 --> X6{"Export format?"}
  X6 -->|"CSV"| X7["Download CSV"]
  X6 -->|"PNG / PDF"| X8["Render image / document"]
