flowchart TD
  U([User]) -->|"user action"| P["pages/Rds.tsx + RdsDetail / CreateRds"]
  P <-->|"request / rendered data"| H["useRds"]
  H <-->|"query request / cached response"| Q["React Query cache<br/>(keys, refetch, invalidate)"]
  Q <-->|"fetch request / parsed response"| A["rdsService"]
  A <-->|"HTTP request / HTTP response"| C["apiClient (Axios)<br/>token injection - 401 refresh - 403 role refresh"]
  C <-->|"REST request / JSON response"| S[("RDS Service")]
  P -->|"renders"| UI
  subgraph UI[Page interactions]
    direction TB
    S0["List DB instances per request"]
    S1["Create RDS (engine, class, storage)"]
    S2["View instance metrics and endpoints"]
    S3["Start / stop / delete instance"]
    S4["Request quota increase"]
    S0 ~~~ S1 ~~~ S2 ~~~ S3 ~~~ S4
  end
  C -. "error response" .-> E["ApiErrorBoundary + toast"]

  %% ---- Key decisions ----
  P -->|"evaluate"| X0
  X0{"Instance status?"} -->|"available"| X1["Allow stop / connect"]
  X0 -->|"stopped"| X2["Allow start only"]
  X0 -->|"modifying"| X3["Disable actions"]
  X4{"Quota available?"} -->|"yes"| X5["Create DB instance"]
  X4 -->|"no"| X6["Request quota increase"]
