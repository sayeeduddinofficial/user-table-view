---
title: Quota Request Service Flow
---
flowchart TD
  U([User]) -->|"user action"| P["pages/QuotaRequests.tsx + QuotaRequestAction.tsx"]
  P <-->|"request / rendered data"| H["useQuotaRequests"]
  H <-->|"query request / cached response"| Q["React Query cache<br/>(keys, refetch, invalidate)"]
  Q <-->|"fetch request / parsed response"| A["quotaRequestsApi"]
  A <-->|"HTTP request / HTTP response"| C["apiClient (Axios)<br/>token injection - 401 refresh - 403 role refresh"]
  C <-->|"REST request / JSON response"| S[("VM Request Service")]
  P -->|"renders"| UI
  subgraph UI[Page interactions]
    direction LR
    S0["Submit quota increase request"]
    S1["Approver review queue"]
    S2["Email link action page (public route)"]
    S3["Quota usage vs limit cards"]
    S0 ~~~ S1 ~~~ S2 ~~~ S3
  end
  C -. "error response" .-> E["ApiErrorBoundary + toast"]

  %% ---- Condition-based paths ----
  Q -->|"cache lookup"| D1{"Cached data<br/>still fresh?"}
  D1 -->|"yes"| P
  D1 -->|"no"| A
  C -->|"before send"| D2{"Access token<br/>valid?"}
  D2 -->|"yes"| S
  D2 -->|"no"| RT["Refresh token"]
  RT -->|"retry request"| S
  RT -. "refresh failed" .-> LO["Sign out - redirect /login"]
  S -->|"response"| D3{"HTTP 2xx?"}
  D3 -->|"yes"| Q
  D3 -->|"no"| D4{"403 role change?"}
  D4 -->|"yes"| RR["Refresh role and retry"]
  D4 -->|"no"| E
  %% ---- Service specific decisions ----
  X0{"Usage below limit?"} -->|"yes"| X1["Allow resource creation"]
  X0 -->|"no"| X2["Prompt quota increase request"]
  X2 --> X3{"Approver decision?"}
  X3 -->|"approved"| X4["Raise limit"]
  X3 -->|"rejected"| X5["Keep limit - notify user"]
