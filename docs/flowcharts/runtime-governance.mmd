---
title: Runtime Governance Service Flow
---
flowchart TD
  U([User]) -->|"user action"| P["pages/RuntimeGovernance.tsx + RunTimeGovernanceAction.tsx"]
  P <-->|"request / rendered data"| H["useRuntimeGovernance"]
  H <-->|"query request / cached response"| Q["React Query cache<br/>(keys, refetch, invalidate)"]
  Q <-->|"fetch request / parsed response"| A["runtimeGovernanceApi"]
  A <-->|"HTTP request / HTTP response"| C["apiClient (Axios)<br/>token injection - 401 refresh - 403 role refresh"]
  C <-->|"REST request / JSON response"| S[("Runtime Governance Service")]
  P -->|"renders"| UI
  subgraph UI[Page interactions]
    direction LR
    S0["Schedule start/stop windows"]
    S1["Extension requests from owners"]
    S2["Approve / reject via email link"]
    S3["Audit of governance actions"]
    S0 ~~~ S1 ~~~ S2 ~~~ S3
  end
  C -. "error response" .-> E["ApiErrorBoundary + toast"]
  E ~~~ UI

  %% ---- Key decisions ----
  P -->|"evaluate"| X0
  X0{"Inside schedule window?"} -->|"yes"| X1["Keep resources running"]
  X0 -->|"no"| X2{"Extension requested?"}
  X2 -->|"yes"| X3{"Approved via email link?"}
  X2 -->|"no"| X4["Auto stop resources"]
  X3 -->|"yes"| X5["Extend runtime window"]
  X3 -->|"no"| X4

